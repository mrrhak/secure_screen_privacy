<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="com.mrrhak.secure_screen_privacy">
  <!-- Install-time ("normal") permission needed by
       Activity.registerScreenCaptureCallback (API 34+), used for screenshot
       detection and the API 34 screen-recording path. Not a storage/media
       permission and never shown to the user; merged into the host app's
       manifest automatically. -->
  <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE" />
</manifest>
