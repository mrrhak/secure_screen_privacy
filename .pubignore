# This file replaces the root .gitignore for pub, so it repeats what must
# stay out of the published package.
.DS_Store
.dart_tool/
.flutter-plugins-dependencies
.build/
.swiftpm/
.idea/
.vscode/
*.iml
*.log
/build/
/coverage/
pubspec.lock

# Repo tooling, not needed to use the package.
CLAUDE.md
cspell.json
# The Pigeon definition only regenerates the lib/src/messages.g.dart,
# Messages.g.kt and Messages.g.swift files that ship.
/pigeon/

# Native unit tests run in this repo's CI only.
/android/src/test/

# doc/images is kept: pubspec.yaml lists a screenshot from it for pub.dev.
# The iOS App Switcher shots are only for the README, which loads them from
# GitHub.
/doc/images/ios_app_switcher_*.png

# The example's platform runners aren't needed to read the example, and
# README images load from GitHub.
/example/android/
/example/ios/
